# Copie para backend/.env (nunca commite o .env)
DJANGO_SECRET_KEY=troque-isto
DJANGO_DEBUG=1
DATABASE_URL=postgres://ergo:ergo@localhost:5433/ergo

# LLM: OpenRouter (modelos :free com suporte a tools)
OPENROUTER_APIKEY=
# Cadeia de modelos tentados antes dos grátis (pagos e baratos, com tools)
OPENROUTER_MODELS=deepseek/deepseek-v4.1-flash,anthropic/claude-haiku-5.5
# Opcional: fixa UM modelo (ignora a cadeia e os grátis)
OPENROUTER_MODEL=
# Teto de gasto com LLM por usuário por dia (US$); passou, responde sem IA
LIMITE_GASTO_DIARIO_USD=0.25

# Embeddings locais (fastembed). "off" = busca só textual.
EMBEDDINGS=on
